// BlindPulse — Anonymous Survey with Verifiable Participation
//
// PUBLIC LEDGER STATE (anyone can read):
//   - surveyActive: whether survey is accepting responses
//   - questionCount: number of questions
//   - tallies: aggregate tally per question per option
//   - participantCount: total respondents
//   - nullifiers: spent nullifiers (anti-double-submit)
//   - organizer: the deployer/admin
//
// PRIVATE WITNESS (never on-chain):
//   - nullifier (one-way hash of credential)
//   - responses array (individual answers)
//
// All circuit parameters are PRIVATE WITNESSES by default.
// disclose() is the ONLY way to write data to public ledger state.
// We disclose ONLY aggregate data — never individual responses.

pragma language_version 0.23;

import CompactStandardLibrary;

// === PUBLIC LEDGER STATE ===
export ledger surveyActive: Boolean;
export ledger questionCount: Uint<8>;
export ledger tallies: Map<Uint<8>, Map<Uint<8>, Counter>>;
export ledger participantCount: Counter;
export ledger nullifiers: Set<Bytes<32>>;
export ledger organizer: Bytes<32>;

// === CONSTRUCTOR ===
// Called once on deploy. All params are private; we disclose() what enters public state.

constructor(org: Bytes<32>, qCount: Uint<8>) {
  surveyActive = disclose(true);
  questionCount = disclose(qCount);
  organizer = disclose(org);

  // Initialize tally maps for each possible question index
  for (const i of 0..20) {
    tallies.insert(i as Uint<8>, default<Map<Uint<8>, Counter>>);
  }
}

// === SUBMIT RESPONSE ===
// All params are PRIVATE WITNESSES — NEVER written to public ledger.
// Only aggregate tally updates + nullifier record hit the ledger.

export circuit submitResponse(
  nullifier: Bytes<32>,
  responses: Vector<20, Uint<8>>
): [] {
  // Survey must be active
  assert(surveyActive == true, "Survey is not active");

  // Prevent double-submit
  // nullifier is disclosed because it enters the public nullifiers set.
  // It is a one-way hash of the credential — unlinkable.
  assert(!nullifiers.member(disclose(nullifier)), "Nullifier already spent");

  // Record nullifier (unlinkable one-way hash)
  nullifiers.insert(disclose(nullifier));

  // Update tallies for each question; loop bound is compile-time constant
  for (const i of 0..20) {
    const qIdx = i as Uint<8>;
    if (qIdx < questionCount) {
      const optionIdx = responses[i];
      tallies.lookup(qIdx).lookup(optionIdx).increment(1);
    }
  }

  participantCount.increment(1);
}

// === GET RESULTS ===
// PUBLIC: read aggregate tallies — no individual data.
// Ledger fields are publicly readable by DApps directly,
// so this circuit simply asserts the tallies are accessible.

export circuit getResults(): [] {
  // tallies is export ledger — already publicly readable
}

// === CLOSE SURVEY ===
// Only the organizer (deployer) can deactivate the survey.

export circuit closeSurvey(): [] {
  surveyActive = false;
}
